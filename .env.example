# Copy to .env and fill in. Never commit the real file.

# Owner / pipeline connection (migrate, ingest, grade, admin).
# Postgres with pg_jsonschema, e.g. Supabase's direct or session-pooler URL.
DATABASE_URL=

# One login per role. Create them with `sportspipeline agents ...`.
AGENT_DATABASE_URL=
EXECUTOR_DATABASE_URL=
HUMAN_DATABASE_URL=

# Executor live mode stays off unless this is 1 AND a live venue adapter exists.
SPORTSPIPELINE_LIVE=0

# Optional
LOG_LEVEL=info
